# =============================================================================
# REACH — AI Business Development Agent for RayvenSC
# Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME=Reach
APP_ENV=development           # development | production
APP_SECRET_KEY=               # 32+ char random secret (openssl rand -hex 32)
APP_DEBUG=true
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://reach:reach_password@localhost:5432/reach
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Host port mapping for PostgreSQL (change if host port 5432 is occupied)
POSTGRES_HOST_PORT=127.0.0.1:5432

# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://reach:reach_password@localhost:5432/reach

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Host port mapping for Redis (change to e.g. 127.0.0.1:6380 if host port 6379 is occupied)
REDIS_HOST_PORT=127.0.0.1:6379

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=               # 32+ char random secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin account (created on first run)
ADMIN_EMAIL=admin@rayvensc.com
ADMIN_PASSWORD=               # Set a strong password

# -----------------------------------------------------------------------------
# LLM PROVIDER (pluggable — set ACTIVE_LLM_PROVIDER)
# -----------------------------------------------------------------------------
ACTIVE_LLM_PROVIDER=openai    # openai | anthropic | gemini | local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Local / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# -----------------------------------------------------------------------------
# EMAIL PROVIDER (pluggable)
# -----------------------------------------------------------------------------
ACTIVE_EMAIL_PROVIDER=gmail   # gmail | outlook | smtp

# Gmail OAuth2 (preferred)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Outlook / Microsoft 365
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_SENDER_EMAIL=

# Generic SMTP (fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=

# -----------------------------------------------------------------------------
# SEARCH PROVIDER (pluggable)
# -----------------------------------------------------------------------------
ACTIVE_SEARCH_PROVIDER=serper  # serper | serpapi | brave | none

SERPER_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=

# -----------------------------------------------------------------------------
# ENRICHMENT PROVIDER (pluggable)
# -----------------------------------------------------------------------------
ACTIVE_ENRICHMENT_PROVIDER=hunter  # hunter | apollo | clearbit | none

# Hunter.io
HUNTER_API_KEY=

# Apollo.io
APOLLO_API_KEY=

# Clearbit (now Breeze by HubSpot)
CLEARBIT_API_KEY=

# -----------------------------------------------------------------------------
# LINKEDIN (browser automation — Playwright)
# -----------------------------------------------------------------------------
LINKEDIN_ENABLED=false
LINKEDIN_SESSION_COOKIE=      # li_at cookie value from authenticated browser
LINKEDIN_RATE_LIMIT_PER_HOUR=20
LINKEDIN_HUMAN_DELAY_MIN_MS=2000
LINKEDIN_HUMAN_DELAY_MAX_MS=8000

# -----------------------------------------------------------------------------
# NOTIFICATION PROVIDER (pluggable)
# -----------------------------------------------------------------------------
ACTIVE_NOTIFICATION_PROVIDER=email  # email | slack | webhook | none

# Slack webhook (optional)
SLACK_WEBHOOK_URL=
SLACK_NOTIFICATION_CHANNEL=#bd-alerts

# Generic webhook
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Human escalation email
ESCALATION_EMAIL=hello@rayvensc.com

# -----------------------------------------------------------------------------
# VECTOR STORE (pgvector used by default — no separate service needed)
# -----------------------------------------------------------------------------
VECTOR_DIMENSIONS=1536        # Must match embedding model dimensions
VECTOR_SIMILARITY_THRESHOLD=0.75

# -----------------------------------------------------------------------------
# CAMPAIGN DEFAULTS
# -----------------------------------------------------------------------------
DEFAULT_FOLLOW_UP_DELAY_HOURS=72
DEFAULT_MAX_FOLLOW_UPS=3
DEFAULT_SEND_WINDOW_START=09  # Hour (24h, prospect timezone)
DEFAULT_SEND_WINDOW_END=17
DEFAULT_DAILY_SEND_LIMIT=50
UNSUBSCRIBE_LINK_ENABLED=true

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=               # Fernet key for encrypting stored credentials
                              # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_REQUESTS_PER_MINUTE=60
